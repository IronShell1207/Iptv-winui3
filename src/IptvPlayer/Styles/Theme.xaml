<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Default">
            <Color x:Key="AppBackgroundColor">#0B1220</Color>
            <Color x:Key="AppSurfaceColor">#141E33</Color>
            <Color x:Key="AppSurfaceHighColor">#1B2840</Color>
            <Color x:Key="AppAccentColor">#2E7CF6</Color>
            <Color x:Key="AppAccentHoverColor">#4A90FF</Color>
            <Color x:Key="AppOnlineColor">#22C55E</Color>
            <Color x:Key="AppOfflineColor">#F43F5E</Color>

            <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="{StaticResource AppSurfaceColor}" Opacity="0.85" />
            <SolidColorBrush x:Key="AppSurfaceHighBrush" Color="{StaticResource AppSurfaceHighColor}" Opacity="0.9" />
            <SolidColorBrush x:Key="AppCardBrush" Color="#16233A" Opacity="0.82" />
            <SolidColorBrush x:Key="AppCardHoverBrush" Color="#1E2E4A" Opacity="0.92" />
            <SolidColorBrush x:Key="AppBorderBrush" Color="#FFFFFF" Opacity="0.08" />
            <SolidColorBrush x:Key="AppAccentBrush" Color="{StaticResource AppAccentColor}" />
            <SolidColorBrush x:Key="AppAccentHoverBrush" Color="{StaticResource AppAccentHoverColor}" />
            <SolidColorBrush x:Key="AppAccentSoftBrush" Color="{StaticResource AppAccentColor}" Opacity="0.18" />
            <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#F3F6FC" />
            <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#9FB0CC" />
            <SolidColorBrush x:Key="AppTextTertiaryBrush" Color="#6C7F9E" />
            <SolidColorBrush x:Key="AppOnlineBrush" Color="{StaticResource AppOnlineColor}" />
            <SolidColorBrush x:Key="AppOfflineBrush" Color="{StaticResource AppOfflineColor}" />
            <SolidColorBrush x:Key="AppChipBrush" Color="#FFFFFF" Opacity="0.07" />
            <SolidColorBrush x:Key="AppScrimBrush" Color="#000000" Opacity="0.55" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <Color x:Key="AppBackgroundColor">#F4F7FC</Color>
            <Color x:Key="AppSurfaceColor">#FFFFFF</Color>
            <Color x:Key="AppSurfaceHighColor">#FFFFFF</Color>
            <Color x:Key="AppAccentColor">#1D6AE5</Color>
            <Color x:Key="AppAccentHoverColor">#3A83F5</Color>
            <Color x:Key="AppOnlineColor">#16A34A</Color>
            <Color x:Key="AppOfflineColor">#E11D48</Color>

            <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFFFFF" Opacity="0.9" />
            <SolidColorBrush x:Key="AppSurfaceHighBrush" Color="#FFFFFF" Opacity="0.95" />
            <SolidColorBrush x:Key="AppCardBrush" Color="#FFFFFF" Opacity="0.9" />
            <SolidColorBrush x:Key="AppCardHoverBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AppBorderBrush" Color="#0F172A" Opacity="0.1" />
            <SolidColorBrush x:Key="AppAccentBrush" Color="{StaticResource AppAccentColor}" />
            <SolidColorBrush x:Key="AppAccentHoverBrush" Color="{StaticResource AppAccentHoverColor}" />
            <SolidColorBrush x:Key="AppAccentSoftBrush" Color="{StaticResource AppAccentColor}" Opacity="0.12" />
            <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#0F172A" />
            <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#475569" />
            <SolidColorBrush x:Key="AppTextTertiaryBrush" Color="#7A8AA3" />
            <SolidColorBrush x:Key="AppOnlineBrush" Color="{StaticResource AppOnlineColor}" />
            <SolidColorBrush x:Key="AppOfflineBrush" Color="{StaticResource AppOfflineColor}" />
            <SolidColorBrush x:Key="AppChipBrush" Color="#0F172A" Opacity="0.06" />
            <SolidColorBrush x:Key="AppScrimBrush" Color="#000000" Opacity="0.5" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <x:Double x:Key="AppCardRadius">16</x:Double>
    <CornerRadius x:Key="AppCardCornerRadius">16</CornerRadius>
    <CornerRadius x:Key="AppControlCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="AppPillCornerRadius">20</CornerRadius>

    <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="34" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
    </Style>

    <Style x:Key="PageSubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextSecondaryBrush}" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <Style x:Key="CardTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="CardCaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextSecondaryBrush}" />
    </Style>

    <Style x:Key="ChipBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AppChipBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource AppPillCornerRadius}" />
        <Setter Property="Padding" Value="10,4" />
    </Style>

    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AppCardBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource AppCardCornerRadius}" />
    </Style>

    <Style x:Key="AccentCircleButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource AppAccentBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="GlassIconButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource AppChipBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="SourceKindButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource AppSurfaceHighBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource AppControlCornerRadius}" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>

    <Style x:Key="SoftButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource AppChipBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource AppControlCornerRadius}" />
        <Setter Property="Padding" Value="16,9" />
    </Style>

    <Style x:Key="AccentButtonStyle2" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource AppAccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource AppControlCornerRadius}" />
        <Setter Property="Padding" Value="18,10" />
    </Style>

</ResourceDictionary>
