<Page
    x:Class="IptvPlayer.Views.RecordingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:IptvPlayer.Controls"
    Background="Transparent">

    <Grid Margin="28,4,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,20">
            <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Записи" />
            <TextBlock Style="{StaticResource PageSubtitleTextStyle}" Text="Сохранённые эфиры" />
        </StackPanel>

        <StackPanel
            Grid.Row="1"
            MaxWidth="460"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="14">
            <controls:SvgIcon
                Width="40"
                Height="40"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource AppTextTertiaryBrush}"
                Glyph="Recordings" />
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="18"
                FontWeight="SemiBold"
                Foreground="{ThemeResource AppTextPrimaryBrush}"
                Text="Записей пока нет" />
            <TextBlock
                Foreground="{ThemeResource AppTextSecondaryBrush}"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Text="Запись эфира ещё не подключена — она появится в следующей версии. Сейчас доступны прямой эфир и телепрограмма." />
        </StackPanel>
    </Grid>
</Page>
