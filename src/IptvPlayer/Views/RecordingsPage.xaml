<Page
	x:Class="IptvPlayer.Views.RecordingsPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="using:IptvPlayer.Controls"
	xmlns:converters="using:IptvPlayer.Converters"
	xmlns:vm="using:IptvPlayer.ViewModels"
	Background="Transparent">

	<Page.Resources>
		<converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />

		<DataTemplate x:Key="RecordingTemplate" x:DataType="vm:RecordingItemViewModel">
			<Grid
				Height="76"
				Padding="16,10"
				ColumnSpacing="16">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<Border
					Width="48"
					Height="48"
					Background="{ThemeResource AppSurfaceHighBrush}"
					CornerRadius="12">
					<controls:SvgIcon
						Width="20"
						Height="20"
						Foreground="{ThemeResource AppAccentBrush}"
						Glyph="Recordings" />
				</Border>

				<StackPanel Grid.Column="1" VerticalAlignment="Center">
					<TextBlock
						FontSize="15"
						FontWeight="SemiBold"
						Foreground="{ThemeResource AppTextPrimaryBrush}"
						Text="{x:Bind Title, Mode=OneWay}"
						TextTrimming="CharacterEllipsis" />
					<TextBlock
						FontSize="12.5"
						Foreground="{ThemeResource AppTextTertiaryBrush}"
						Text="{x:Bind Subtitle, Mode=OneWay}"
						TextTrimming="CharacterEllipsis" />
				</StackPanel>

				<StackPanel
					Grid.Column="2"
					VerticalAlignment="Center"
					Orientation="Horizontal"
					Spacing="6">
					<Button
						Click="OnPlayClick"
						Style="{StaticResource GlassIconButtonStyle}"
						Tag="{x:Bind}"
						ToolTipService.ToolTip="Смотреть"
						Visibility="{x:Bind IsPlayable, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
						<controls:SvgIcon
							Width="16"
							Height="16"
							Foreground="{ThemeResource AppTextPrimaryBrush}"
							Glyph="Play"
							IsFilled="True" />
					</Button>

					<Button
						Click="OnStopClick"
						Style="{StaticResource GlassIconButtonStyle}"
						Tag="{x:Bind}"
						ToolTipService.ToolTip="Остановить запись"
						Visibility="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
						<controls:SvgIcon
							Width="14"
							Height="14"
							Foreground="#EF4444"
							Glyph="RecordStop" />
					</Button>

					<Button
						Click="OnDeleteClick"
						Style="{StaticResource GlassIconButtonStyle}"
						Tag="{x:Bind}"
						ToolTipService.ToolTip="Удалить">
						<controls:SvgIcon
							Width="16"
							Height="16"
							Foreground="{ThemeResource AppTextSecondaryBrush}"
							Glyph="Delete" />
					</Button>
				</StackPanel>
			</Grid>
		</DataTemplate>
	</Page.Resources>

	<Grid Margin="28,4,28,20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<Grid Margin="0,0,0,20">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<StackPanel VerticalAlignment="Center">
				<TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Записи" />
				<TextBlock Style="{StaticResource PageSubtitleTextStyle}" Text="Сохранённые эфиры и то, что пишется сейчас" />
			</StackPanel>

			<Button
				Grid.Column="1"
				VerticalAlignment="Center"
				Click="OnOpenFolderClick"
				Style="{StaticResource SoftButtonStyle}">
				<StackPanel Orientation="Horizontal" Spacing="10">
					<controls:SvgIcon
						Width="17"
						Height="17"
						Foreground="{ThemeResource AppTextPrimaryBrush}"
						Glyph="Folder" />
					<TextBlock VerticalAlignment="Center" Text="Открыть папку" />
				</StackPanel>
			</Button>
		</Grid>

		<Grid Grid.Row="1">
			<ListView
				ItemContainerStyle="{StaticResource PlayerChannelItemStyle}"
				ItemTemplate="{StaticResource RecordingTemplate}"
				ItemsSource="{x:Bind ViewModel.Items}"
				SelectionMode="None"
				Style="{StaticResource BareListViewStyle}" />

			<StackPanel
				MaxWidth="460"
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				Spacing="14"
				Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
				<controls:SvgIcon
					Width="40"
					Height="40"
					HorizontalAlignment="Center"
					Foreground="{ThemeResource AppTextTertiaryBrush}"
					Glyph="Recordings" />
				<TextBlock
					HorizontalAlignment="Center"
					FontSize="18"
					FontWeight="SemiBold"
					Foreground="{ThemeResource AppTextPrimaryBrush}"
					Text="Записей пока нет" />
				<TextBlock
					Foreground="{ThemeResource AppTextSecondaryBrush}"
					TextAlignment="Center"
					TextWrapping="Wrap"
					Text="Во время просмотра нажмите кнопку записи: можно писать вручную или до конца текущей передачи по телепрограмме." />
			</StackPanel>
		</Grid>
	</Grid>
</Page>
