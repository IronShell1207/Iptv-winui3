<Page
    x:Class="IptvPlayer.Views.PlaylistsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:IptvPlayer.Controls"
    xmlns:converters="using:IptvPlayer.Converters"
    xmlns:vm="using:IptvPlayer.ViewModels"
    Background="Transparent">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:OnlineToBrushConverter x:Key="OnlineToBrush" />
        <converters:HexToBrushConverter x:Key="HexToBrush" />

        <DataTemplate x:Key="PlaylistCardTemplate" x:DataType="vm:PlaylistItemViewModel">
            <Border
                Width="376"
                Height="300"
                Background="{ThemeResource AppCardBrush}"
                BorderBrush="{ThemeResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource AppCardCornerRadius}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="150" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Обложка -->
                    <Grid Grid.Row="0">
                        <Border Background="{x:Bind CoverColor, Converter={StaticResource HexToBrush}}" />
                        <Border>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0.35,1">
                                    <GradientStop Offset="0" Color="#00000000" />
                                    <GradientStop Offset="1" Color="#99000000" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- Бейдж статуса -->
                        <Border
                            Margin="0,14,58,0"
                            Padding="10,5"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="#66000000"
                            CornerRadius="{StaticResource AppPillCornerRadius}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Ellipse
                                    Width="8"
                                    Height="8"
                                    VerticalAlignment="Center"
                                    Fill="{x:Bind IsOnline, Mode=OneWay, Converter={StaticResource OnlineToBrush}}" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="White"
                                    Text="{x:Bind StatusText, Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <!-- Меню карточки -->
                        <Button
                            Width="34"
                            Height="34"
                            Margin="0,14,14,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="#66000000"
                            CornerRadius="17"
                            Padding="0"
                            BorderThickness="0"
                            ToolTipService.ToolTip="Действия">
                            <controls:SvgIcon
                                Width="18"
                                Height="18"
                                Foreground="White"
                                Glyph="More" />
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem
                                        Click="OnRefreshClick"
                                        Tag="{x:Bind}"
                                        Text="Обновить" />
                                    <MenuFlyoutItem
                                        Click="OnRenameClick"
                                        Tag="{x:Bind}"
                                        Text="Переименовать" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem
                                        Click="OnRemoveClick"
                                        Tag="{x:Bind}"
                                        Text="Удалить" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>

                        <!-- Иконка плейлиста -->
                        <Border
                            Width="52"
                            Height="52"
                            Margin="20,0,0,-26"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Background="{ThemeResource AppSurfaceHighBrush}"
                            BorderBrush="{ThemeResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14">
                            <controls:SvgIcon
                                Width="24"
                                Height="24"
                                Foreground="{ThemeResource AppTextPrimaryBrush}"
                                Glyph="Playlists" />
                        </Border>
                    </Grid>

                    <!-- Текстовая часть -->
                    <Grid Grid.Row="1" Margin="20,36,20,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="{x:Bind Name, Mode=OneWay}" />

                        <TextBlock
                            Grid.Row="1"
                            Margin="0,2,0,0"
                            Style="{StaticResource CardCaptionTextStyle}"
                            Text="{x:Bind ChannelCountText, Mode=OneWay}" />

                        <ItemsControl
                            Grid.Row="2"
                            Margin="0,12,0,0"
                            VerticalAlignment="Top"
                            ItemsSource="{x:Bind TopGroups, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border Style="{StaticResource ChipBorderStyle}">
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource AppTextSecondaryBrush}"
                                            Text="{x:Bind}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Grid.Row="3" VerticalAlignment="Bottom">
                            <StackPanel
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="8">
                                <controls:SvgIcon
                                    Width="15"
                                    Height="15"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource AppTextTertiaryBrush}"
                                    Glyph="Refresh" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{ThemeResource AppTextTertiaryBrush}"
                                    Text="{x:Bind UpdatedText, Mode=OneWay}" />
                            </StackPanel>

                            <Button
                                HorizontalAlignment="Right"
                                Click="OnOpenClick"
                                Style="{StaticResource AccentCircleButtonStyle}"
                                Tag="{x:Bind}"
                                ToolTipService.ToolTip="Открыть каналы">
                                <controls:SvgIcon
                                    Width="18"
                                    Height="18"
                                    Foreground="White"
                                    Glyph="Play"
                                    IsFilled="True" />
                            </Button>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="AddCardTemplate">
            <Button
                Width="376"
                Height="300"
                Background="Transparent"
                BorderBrush="{ThemeResource AppBorderBrush}"
                BorderThickness="1"
                Click="OnAddClick"
                CornerRadius="{StaticResource AppCardCornerRadius}">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="14">
                    <Border
                        Width="64"
                        Height="64"
                        HorizontalAlignment="Center"
                        Background="{ThemeResource AppChipBrush}"
                        CornerRadius="32">
                        <controls:SvgIcon
                            Width="26"
                            Height="26"
                            Foreground="{ThemeResource AppTextSecondaryBrush}"
                            Glyph="Add" />
                    </Border>
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource AppTextPrimaryBrush}"
                        Text="Добавить плейлист" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource AppTextTertiaryBrush}"
                        Text="M3U, Xtream Codes&#x0a;или локальный файл"
                        TextAlignment="Center" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <controls:PlaylistCardTemplateSelector
            x:Key="PlaylistCardSelector"
            AddTemplate="{StaticResource AddCardTemplate}"
            PlaylistTemplate="{StaticResource PlaylistCardTemplate}" />
    </Page.Resources>

    <Grid Margin="28,4,28,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Заголовок и поиск -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Плейлисты" />
                <TextBlock Style="{StaticResource PageSubtitleTextStyle}" Text="Управляйте плейлистами и начинайте смотреть" />
            </StackPanel>

            <Border
                Grid.Column="1"
                Width="340"
                Height="44"
                Margin="0,0,14,0"
                VerticalAlignment="Center"
                Background="{ThemeResource AppSurfaceBrush}"
                BorderBrush="{ThemeResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource AppPillCornerRadius}">
                <Grid Margin="16,0" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <controls:SvgIcon
                        Width="18"
                        Height="18"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource AppTextTertiaryBrush}"
                        Glyph="Search" />

                    <TextBox
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        PlaceholderText="Поиск плейлистов…"
                        Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </Border>

            <Button
                Grid.Column="2"
                Height="44"
                Padding="20,0"
                VerticalAlignment="Center"
                Background="{ThemeResource AppAccentBrush}"
                BorderThickness="0"
                Click="OnAddClick"
                CornerRadius="{StaticResource AppPillCornerRadius}"
                Foreground="White">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <controls:SvgIcon
                        Width="18"
                        Height="18"
                        Foreground="White"
                        Glyph="Add" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="Добавить" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Карточки -->
        <ScrollViewer
            Grid.Row="1"
            Padding="0,0,8,0"
            VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemTemplateSelector="{StaticResource PlaylistCardSelector}" ItemsSource="{x:Bind ViewModel.Items}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:WrapPanel HorizontalSpacing="20" VerticalSpacing="20" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>

        <!-- Нижняя подсказка со способами добавления -->
        <Border
            Grid.Row="2"
            Margin="0,20,0,20"
            Padding="20,16"
            Background="{ThemeResource AppCardBrush}"
            BorderBrush="{ThemeResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource AppCardCornerRadius}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Width="48"
                    Height="48"
                    Background="{ThemeResource AppAccentSoftBrush}"
                    CornerRadius="14">
                    <controls:SvgIcon
                        Width="22"
                        Height="22"
                        Foreground="{ThemeResource AppAccentBrush}"
                        Glyph="Playlists" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource AppTextPrimaryBrush}"
                        Text="Плейлист можно добавить по-разному" />
                    <TextBlock
                        Margin="0,2,0,0"
                        Style="{StaticResource CardCaptionTextStyle}"
                        Text="M3U, M3U8, Xtream Codes и локальные файлы" />
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="12">
                    <Button
                        Click="OnAddM3uClick"
                        Style="{StaticResource SourceKindButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <controls:SvgIcon
                                Width="20"
                                Height="20"
                                Foreground="{ThemeResource AppAccentBrush}"
                                Glyph="Link" />
                            <StackPanel>
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource AppTextPrimaryBrush}"
                                    Text="M3U-плейлист" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{ThemeResource AppTextTertiaryBrush}"
                                    Text="Ссылка или файл" />
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Button Click="OnAddXtreamClick" Style="{StaticResource SourceKindButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <controls:SvgIcon
                                Width="20"
                                Height="20"
                                Foreground="{ThemeResource AppAccentBrush}"
                                Glyph="Server" />
                            <StackPanel>
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource AppTextPrimaryBrush}"
                                    Text="Xtream Codes" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{ThemeResource AppTextTertiaryBrush}"
                                    Text="Сервер, логин, пароль" />
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Button Click="OnAddFileClick" Style="{StaticResource SourceKindButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <controls:SvgIcon
                                Width="20"
                                Height="20"
                                Foreground="{ThemeResource AppAccentBrush}"
                                Glyph="Folder" />
                            <StackPanel>
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource AppTextPrimaryBrush}"
                                    Text="Локальный файл" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{ThemeResource AppTextTertiaryBrush}"
                                    Text="Импорт с устройства" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
