<Page
    x:Class="IptvPlayer.Views.EpgPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:IptvPlayer.Controls"
    xmlns:converters="using:IptvPlayer.Converters"
    xmlns:vm="using:IptvPlayer.ViewModels"
    Background="Transparent">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />

        <DataTemplate x:Key="ChannelPickerTemplate" x:DataType="vm:ChannelItemViewModel">
            <Grid Height="48" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource AppTextTertiaryBrush}"
                    Text="{x:Bind Number}"
                    TextAlignment="Right" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource AppTextPrimaryBrush}"
                    Text="{x:Bind Name}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="EpgSlotTemplate" x:DataType="vm:EpgSlotViewModel">
            <Grid
                Padding="18,14"
                ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Width="64" Spacing="4">
                    <TextBlock
                        FontSize="17"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource AppTextPrimaryBrush}"
                        Text="{x:Bind StartTime}" />
                    <Border
                        Width="34"
                        Height="3"
                        HorizontalAlignment="Left"
                        Background="{ThemeResource AppAccentBrush}"
                        CornerRadius="2"
                        Visibility="{x:Bind IsCurrent, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock
                            FontSize="15.5"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource AppTextPrimaryBrush}"
                            Text="{x:Bind Title}"
                            TextTrimming="CharacterEllipsis" />
                        <Border
                            Padding="8,2"
                            VerticalAlignment="Center"
                            Background="{ThemeResource AppAccentSoftBrush}"
                            CornerRadius="{StaticResource AppPillCornerRadius}"
                            Visibility="{x:Bind IsCurrent, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource AppAccentBrush}"
                                Text="СЕЙЧАС" />
                        </Border>
                    </StackPanel>

                    <TextBlock
                        FontSize="12.5"
                        Foreground="{ThemeResource AppTextTertiaryBrush}"
                        Text="{x:Bind TimeRange}" />

                    <ProgressBar
                        Height="3"
                        Margin="0,2,0,0"
                        CornerRadius="2"
                        Foreground="{ThemeResource AppAccentBrush}"
                        Maximum="1"
                        Value="{x:Bind Progress}"
                        Visibility="{x:Bind IsCurrent, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock
                        Foreground="{ThemeResource AppTextSecondaryBrush}"
                        Text="{x:Bind Description}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind HasDescription, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="28,4,28,20" ColumnSpacing="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.ColumnSpan="2"
            Margin="0,0,0,20">
            <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Телепрограмма" />
            <TextBlock Style="{StaticResource PageSubtitleTextStyle}" Text="Что идёт сейчас и что будет дальше" />
        </StackPanel>

        <!-- Выбор канала -->
        <Border
            Grid.Row="1"
            Padding="10"
            Background="{ThemeResource AppCardBrush}"
            BorderBrush="{ThemeResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource AppCardCornerRadius}">
            <ListView
                ItemContainerStyle="{StaticResource PlayerChannelItemStyle}"
                ItemTemplate="{StaticResource ChannelPickerTemplate}"
                ItemsSource="{x:Bind ViewModel.Channels.Channels}"
                SelectedItem="{x:Bind ViewModel.SelectedChannel, Mode=TwoWay}"
                SelectionMode="Single"
                Style="{StaticResource BareListViewStyle}" />
        </Border>

        <!-- Сетка -->
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,14" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button
                    Command="{x:Bind ViewModel.PreviousDayCommand}"
                    Style="{StaticResource GlassIconButtonStyle}"
                    ToolTipService.ToolTip="Предыдущий день">
                    <controls:SvgIcon
                        Width="18"
                        Height="18"
                        Foreground="{ThemeResource AppTextPrimaryBrush}"
                        Glyph="ChevronLeft" />
                </Button>

                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource AppTextPrimaryBrush}"
                    Text="{x:Bind ViewModel.DayTitle, Mode=OneWay}" />

                <Button
                    Grid.Column="2"
                    Command="{x:Bind ViewModel.TodayCommand}"
                    Content="Сегодня"
                    Style="{StaticResource SoftButtonStyle}" />

                <Button
                    Grid.Column="3"
                    Command="{x:Bind ViewModel.NextDayCommand}"
                    Style="{StaticResource GlassIconButtonStyle}"
                    ToolTipService.ToolTip="Следующий день">
                    <controls:SvgIcon
                        Width="18"
                        Height="18"
                        Foreground="{ThemeResource AppTextPrimaryBrush}"
                        Glyph="ChevronRight" />
                </Button>
            </Grid>

            <Border
                Grid.Row="1"
                Background="{ThemeResource AppCardBrush}"
                BorderBrush="{ThemeResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource AppCardCornerRadius}">
                <Grid>
                    <ListView
                        ItemTemplate="{StaticResource EpgSlotTemplate}"
                        ItemsSource="{x:Bind ViewModel.Slots}"
                        SelectionMode="None"
                        Style="{StaticResource BareListViewStyle}" />

                    <StackPanel
                        MaxWidth="400"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="14"
                        Visibility="{x:Bind ViewModel.EmptyMessage, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <controls:SvgIcon
                            Width="36"
                            Height="36"
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource AppTextTertiaryBrush}"
                            Glyph="Guide" />
                        <TextBlock
                            Foreground="{ThemeResource AppTextSecondaryBrush}"
                            Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
