<UserControl
    x:Class="IptvPlayer.Views.PlayerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:IptvPlayer.Controls"
    xmlns:converters="using:IptvPlayer.Converters"
    xmlns:vm="using:IptvPlayer.ViewModels">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:PathToImageConverter x:Key="PathToImage" />

        <!-- Канал в выезжающей панели -->
        <DataTemplate x:Key="PlayerChannelTemplate" x:DataType="vm:ChannelItemViewModel">
            <Grid
                Height="70"
                Padding="10,8"
                ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Логотип или инициалы -->
                <Border
                    Width="64"
                    Height="54"
                    Background="{ThemeResource AppSurfaceHighBrush}"
                    CornerRadius="8">
                    <Grid>
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource AppTextTertiaryBrush}"
                            Text="{x:Bind Initials}"
                            Visibility="{x:Bind HasLogo, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                        <Image
                            Margin="6,5"
                            Source="{x:Bind LogoPath, Mode=OneWay, Converter={StaticResource PathToImage}}"
                            Stretch="Uniform" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{ThemeResource AppTextTertiaryBrush}"
                            Text="{x:Bind Number}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="14.5"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource AppTextPrimaryBrush}"
                            Text="{x:Bind Name}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock
                        FontSize="12.5"
                        Foreground="{ThemeResource AppTextTertiaryBrush}"
                        Text="{x:Bind Group}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- Индикатор «играет сейчас» -->
                <controls:SvgIcon
                    Grid.Column="2"
                    Width="18"
                    Height="18"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource AppAccentBrush}"
                    Glyph="Signal"
                    Visibility="{x:Bind IsPlaying, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="Root" Background="#05080F">

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WidthStates">

                <!-- Узкое окно: панель уже, второстепенное убрано -->
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ChannelPanel.Width" Value="288" />
                        <Setter Target="ChannelPanel.Margin" Value="12,12,0,12" />
                        <Setter Target="ChannelNameText.FontSize" Value="24" />
                        <Setter Target="ClockTimeText.FontSize" Value="22" />
                        <Setter Target="MoreButton.Visibility" Value="Collapsed" />
                        <Setter Target="PipButton.Visibility" Value="Collapsed" />
                        <Setter Target="ControlsPanel.Spacing" Value="10" />
                    </VisualState.Setters>
                </VisualState>

                <!-- Среднее окно -->
                <VisualState x:Name="MediumState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1000" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ChannelPanel.Width" Value="360" />
                        <Setter Target="ChannelNameText.FontSize" Value="28" />
                        <Setter Target="ClockTimeText.FontSize" Value="26" />
                        <Setter Target="ControlsPanel.Spacing" Value="14" />
                    </VisualState.Setters>
                </VisualState>

                <!-- Широкое окно: макет как в исходном оформлении -->
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1360" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ChannelPanel.Width" Value="416" />
                        <Setter Target="ChannelNameText.FontSize" Value="34" />
                        <Setter Target="ClockTimeText.FontSize" Value="30" />
                        <Setter Target="ControlsPanel.Spacing" Value="16" />
                    </VisualState.Setters>
                </VisualState>

            </VisualStateGroup>

            <VisualStateGroup x:Name="HeightStates">
                <VisualState x:Name="ShortState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowHeight="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ClockPanel.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="TallState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowHeight="560" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- Видео -->
        <MediaPlayerElement
            x:Name="VideoElement"
            AreTransportControlsEnabled="False"
            IsHitTestVisible="False"
            Stretch="Uniform" />

        <!-- Индикатор буферизации -->
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16"
            Visibility="{x:Bind ViewModel.IsBuffering, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <ProgressRing
                Width="52"
                Height="52"
                Foreground="{ThemeResource AppAccentBrush}"
                IsActive="{x:Bind ViewModel.IsBuffering, Mode=OneWay}" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource AppTextSecondaryBrush}"
                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
        </StackPanel>

        <!-- Ошибка -->
        <Border
            Padding="32,28"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{ThemeResource AppSurfaceHighBrush}"
            BorderBrush="{ThemeResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource AppCardCornerRadius}"
            Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <StackPanel MaxWidth="420" Spacing="14">
                <controls:SvgIcon
                    Width="36"
                    Height="36"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource AppOfflineBrush}"
                    Glyph="Warning" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource AppTextPrimaryBrush}"
                    Text="Канал не отвечает" />
                <TextBlock
                    Foreground="{ThemeResource AppTextSecondaryBrush}"
                    Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button
                    HorizontalAlignment="Center"
                    Command="{x:Bind ViewModel.RetryCommand}"
                    Content="Повторить"
                    Style="{StaticResource AccentButtonStyle2}" />
            </StackPanel>
        </Border>

        <!-- Часы в правом верхнем углу -->
        <StackPanel
            x:Name="ClockPanel"
            Margin="0,24,32,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            IsHitTestVisible="False"
            Opacity="{x:Bind ChromeOpacity, Mode=OneWay}">
            <StackPanel.OpacityTransition>
                <ScalarTransition Duration="0:0:0.2" />
            </StackPanel.OpacityTransition>
            <TextBlock
                x:Name="ClockTimeText"
                HorizontalAlignment="Right"
                FontSize="30"
                FontWeight="SemiLight"
                Foreground="White"
                Text="{x:Bind ViewModel.ClockTime, Mode=OneWay}" />
            <TextBlock
                HorizontalAlignment="Right"
                FontSize="13"
                Foreground="#B9C6DD"
                Text="{x:Bind ViewModel.ClockDate, Mode=OneWay}" />
        </StackPanel>

        <!-- Ввод номера канала -->
        <Border
            Padding="28,16"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,90,0,0"
            Background="#B3000000"
            CornerRadius="{StaticResource AppCardCornerRadius}"
            Visibility="{x:Bind ViewModel.NumberOsd, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <TextBlock
                FontSize="42"
                FontWeight="SemiBold"
                Foreground="White"
                Text="{x:Bind ViewModel.NumberOsd, Mode=OneWay}" />
        </Border>

        <!-- Горячая зона у левого края: подводишь курсор — выезжает список каналов -->
        <Border
            x:Name="ChannelPanelHotZone"
            Width="28"
            HorizontalAlignment="Left"
            Background="Transparent"
            PointerEntered="OnHotZoneEntered" />

        <!-- Левая панель каналов -->
        <Border
            x:Name="ChannelPanel"
            Width="416"
            Margin="24,16,0,16"
            HorizontalAlignment="Left"
            Background="#D90E1526"
            BorderBrush="{ThemeResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource AppCardCornerRadius}"
            IsHitTestVisible="{x:Bind ViewModel.IsChannelPanelOpen, Mode=OneWay}"
            Opacity="{x:Bind ChannelPanelOpacity, Mode=OneWay}"
            PointerEntered="OnChromePointerEntered"
            PointerExited="OnChromePointerExited">

            <Border.OpacityTransition>
                <ScalarTransition Duration="0:0:0.18" />
            </Border.OpacityTransition>
            <Border.TranslationTransition>
                <Vector3Transition Duration="0:0:0.18" />
            </Border.TranslationTransition>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Мини-рейка слева -->
                <StackPanel
                    Margin="10,14"
                    VerticalAlignment="Top"
                    Spacing="8">
                    <Button
                        Click="OnFocusSearchClick"
                        Style="{StaticResource GlassIconButtonStyle}"
                        ToolTipService.ToolTip="Поиск">
                        <controls:SvgIcon
                            Width="18"
                            Height="18"
                            Foreground="{ThemeResource AppTextSecondaryBrush}"
                            Glyph="Search" />
                    </Button>

                    <Button
                        Click="OnAllChannelsClick"
                        Style="{StaticResource GlassIconButtonStyle}"
                        ToolTipService.ToolTip="Все каналы">
                        <controls:SvgIcon
                            Width="18"
                            Height="18"
                            Foreground="White"
                            Glyph="Playlists" />
                    </Button>

                    <Button
                        Click="OnGroupsClick"
                        Style="{StaticResource GlassIconButtonStyle}"
                        ToolTipService.ToolTip="Группы">
                        <controls:SvgIcon
                            Width="18"
                            Height="18"
                            Foreground="{ThemeResource AppTextSecondaryBrush}"
                            Glyph="Channels" />
                    </Button>

                    <Button
                        Click="OnFavoritesClick"
                        Style="{StaticResource GlassIconButtonStyle}"
                        ToolTipService.ToolTip="Избранное">
                        <controls:SvgIcon
                            Width="18"
                            Height="18"
                            Foreground="{ThemeResource AppTextSecondaryBrush}"
                            Glyph="Favorites" />
                    </Button>

                    <Button
                        Click="OnGuideClick"
                        Style="{StaticResource GlassIconButtonStyle}"
                        ToolTipService.ToolTip="Телепрограмма">
                        <controls:SvgIcon
                            Width="18"
                            Height="18"
                            Foreground="{ThemeResource AppTextSecondaryBrush}"
                            Glyph="Guide" />
                    </Button>

                    <Button
                        Click="OnSettingsClick"
                        Style="{StaticResource GlassIconButtonStyle}"
                        ToolTipService.ToolTip="Настройки">
                        <controls:SvgIcon
                            Width="18"
                            Height="18"
                            Foreground="{ThemeResource AppTextSecondaryBrush}"
                            Glyph="Settings" />
                    </Button>
                </StackPanel>

                <Grid Grid.Column="1" Margin="0,14,14,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Выбор группы и поиск -->
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ComboBox
                            x:Name="GroupCombo"
                            HorizontalAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="17"
                            ItemsSource="{x:Bind ViewModel.Channels.Groups}"
                            SelectedItem="{x:Bind ViewModel.Channels.SelectedGroup, Mode=TwoWay}" />

                        <Button
                            Grid.Column="1"
                            Click="OnFocusSearchClick"
                            Style="{StaticResource GlassIconButtonStyle}"
                            ToolTipService.ToolTip="Поиск по каналам">
                            <controls:SvgIcon
                                Width="18"
                                Height="18"
                                Foreground="{ThemeResource AppTextSecondaryBrush}"
                                Glyph="Filter" />
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBox
                            x:Name="SearchBox"
                            Grid.Row="0"
                            Margin="0,0,0,8"
                            PlaceholderText="Поиск канала…"
                            Text="{x:Bind ViewModel.Channels.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Visibility="Collapsed" />

                        <ListView
                            x:Name="ChannelList"
                            Grid.Row="1"
                            ItemContainerStyle="{StaticResource PlayerChannelItemStyle}"
                            ItemTemplate="{StaticResource PlayerChannelTemplate}"
                            ItemsSource="{x:Bind ViewModel.Channels.Channels}"
                            SelectionMode="Single"
                            Style="{StaticResource BareListViewStyle}"
                            ItemClick="OnChannelClick"
                            IsItemClickEnabled="True" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- Кнопки справа -->
        <StackPanel
            Margin="0,0,32,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            IsHitTestVisible="{x:Bind ViewModel.AreControlsVisible, Mode=OneWay}"
            Opacity="{x:Bind ChromeOpacity, Mode=OneWay}"
            Spacing="12">
            <StackPanel.OpacityTransition>
                <ScalarTransition Duration="0:0:0.2" />
            </StackPanel.OpacityTransition>
            <Button
                Width="48"
                Height="48"
                Command="{x:Bind ViewModel.ToggleFavoriteCommand}"
                CornerRadius="24"
                Style="{StaticResource GlassIconButtonStyle}"
                ToolTipService.ToolTip="В избранное">
                <controls:SvgIcon
                    Width="20"
                    Height="20"
                    Foreground="White"
                    Glyph="Favorites"
                    IsFilled="{x:Bind ViewModel.IsFavorite, Mode=OneWay}" />
            </Button>

            <Button
                Width="48"
                Height="48"
                Command="{x:Bind ViewModel.ToggleChannelPanelCommand}"
                CornerRadius="24"
                Style="{StaticResource GlassIconButtonStyle}"
                ToolTipService.ToolTip="Список каналов">
                <controls:SvgIcon
                    Width="20"
                    Height="20"
                    Foreground="White"
                    Glyph="ChannelList" />
            </Button>

            <Button
                x:Name="PipButton"
                Width="48"
                Height="48"
                Command="{x:Bind ViewModel.ToggleCompactOverlayCommand}"
                CornerRadius="24"
                Style="{StaticResource GlassIconButtonStyle}"
                ToolTipService.ToolTip="Поверх окон">
                <controls:SvgIcon
                    Width="20"
                    Height="20"
                    Foreground="White"
                    Glyph="Pip" />
            </Button>
        </StackPanel>

        <!-- Нижняя панель -->
        <Grid
            VerticalAlignment="Bottom"
            IsHitTestVisible="{x:Bind ViewModel.AreControlsVisible, Mode=OneWay}"
            Opacity="{x:Bind ChromeOpacity, Mode=OneWay}"
            PointerEntered="OnChromePointerEntered"
            PointerExited="OnChromePointerExited">
            <Grid.OpacityTransition>
                <ScalarTransition Duration="0:0:0.2" />
            </Grid.OpacityTransition>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.RowSpan="2">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#00000000" />
                        <GradientStop Offset="0.45" Color="#A6000000" />
                        <GradientStop Offset="1" Color="#E6000000" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Информация о канале и передаче -->
            <Grid
                x:Name="InfoGrid"
                Grid.Row="0"
                Margin="{x:Bind InfoMargin, Mode=OneWay}"
                ColumnSpacing="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse
                            Width="9"
                            Height="9"
                            VerticalAlignment="Center"
                            Fill="#EF4444" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="LIVE" />
                    </StackPanel>

                    <TextBlock
                        x:Name="ChannelNameText"
                        FontSize="34"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="{x:Bind ViewModel.ChannelName, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />

                    <TextBlock
                        FontSize="17"
                        Foreground="#CBD5E8"
                        Text="{x:Bind ViewModel.NowTitle, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{x:Bind ViewModel.HasEpg, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                    <!-- Прогресс передачи -->
                    <Grid
                        Margin="0,12,0,0"
                        Visibility="{x:Bind ViewModel.HasEpg, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ProgressBar
                            Height="4"
                            Background="#33FFFFFF"
                            CornerRadius="2"
                            Foreground="{ThemeResource AppAccentBrush}"
                            Maximum="1"
                            Value="{x:Bind ViewModel.NowProgress, Mode=OneWay}" />

                        <Grid Grid.Row="1" Margin="0,8,0,0">
                            <TextBlock
                                FontSize="12.5"
                                Foreground="#9FB0CC"
                                Text="{x:Bind ViewModel.NowStart, Mode=OneWay}" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                FontSize="12.5"
                                Foreground="#9FB0CC"
                                Text="{x:Bind ViewModel.NowStop, Mode=OneWay}" />
                        </Grid>
                    </Grid>
                </StackPanel>

                <!-- Далее -->
                <Border
                    x:Name="NextBlock"
                    Grid.Column="1"
                    Padding="24,0,0,0"
                    VerticalAlignment="Bottom"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="1,0,0,0"
                    Visibility="{x:Bind ShowNextBlock, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel MaxWidth="240" Spacing="3">
                            <TextBlock
                                FontSize="11"
                                Foreground="#8FA2BF"
                                Text="ДАЛЕЕ" />
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="{x:Bind ViewModel.NextTitle, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                FontSize="12.5"
                                Foreground="#9FB0CC"
                                Text="{x:Bind ViewModel.NextTimeRange, Mode=OneWay}" />
                        </StackPanel>

                        <controls:SvgIcon
                            Grid.Column="1"
                            Width="20"
                            Height="20"
                            VerticalAlignment="Center"
                            Foreground="#8FA2BF"
                            Glyph="ChevronRight" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Кнопки управления -->
            <StackPanel
                x:Name="ControlsPanel"
                Grid.Row="1"
                Margin="{x:Bind ControlsMargin, Mode=OneWay}"
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="16">

                <Button
                    x:Name="MoreButton"
                    Width="48"
                    Height="48"
                    Click="OnMoreClick"
                    CornerRadius="24"
                    Style="{StaticResource GlassIconButtonStyle}"
                    ToolTipService.ToolTip="Ещё">
                    <controls:SvgIcon
                        Width="20"
                        Height="20"
                        Foreground="White"
                        Glyph="More" />
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Click="OnCloseClick" Text="Закрыть плеер" />
                            <MenuFlyoutItem Click="OnRefreshStreamClick" Text="Переподключиться" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <Button
                    Width="52"
                    Height="52"
                    Command="{x:Bind ViewModel.PreviousChannelCommand}"
                    CornerRadius="26"
                    Style="{StaticResource GlassIconButtonStyle}"
                    ToolTipService.ToolTip="Предыдущий канал">
                    <controls:SvgIcon
                        Width="20"
                        Height="20"
                        Foreground="White"
                        Glyph="Previous" />
                </Button>

                <!-- Главная кнопка -->
                <Grid Width="76" Height="76">
                    <Ellipse Fill="#332E7CF6" />
                    <Ellipse
                        Margin="6"
                        Stroke="{ThemeResource AppAccentBrush}"
                        StrokeThickness="2" />
                    <Button
                        Width="64"
                        Height="64"
                        Background="#1A2E7CF6"
                        BorderThickness="0"
                        Command="{x:Bind ViewModel.TogglePlayPauseCommand}"
                        CornerRadius="32"
                        Padding="0">
                        <controls:SvgIcon
                            Width="26"
                            Height="26"
                            Foreground="{ThemeResource AppAccentHoverBrush}"
                            Glyph="{x:Bind PlayPauseGlyph, Mode=OneWay}" />
                    </Button>
                </Grid>

                <Button
                    Width="52"
                    Height="52"
                    Command="{x:Bind ViewModel.NextChannelCommand}"
                    CornerRadius="26"
                    Style="{StaticResource GlassIconButtonStyle}"
                    ToolTipService.ToolTip="Следующий канал">
                    <controls:SvgIcon
                        Width="20"
                        Height="20"
                        Foreground="White"
                        Glyph="Next" />
                </Button>

                <Button
                    Width="48"
                    Height="48"
                    CornerRadius="24"
                    Style="{StaticResource GlassIconButtonStyle}"
                    ToolTipService.ToolTip="Громкость">
                    <controls:SvgIcon
                        Width="20"
                        Height="20"
                        Foreground="White"
                        Glyph="{x:Bind VolumeGlyph, Mode=OneWay}" />
                    <Button.Flyout>
                        <Flyout>
                            <StackPanel Width="220" Spacing="10">
                                <Slider
                                    Maximum="100"
                                    Minimum="0"
                                    Value="{x:Bind ViewModel.Volume, Mode=TwoWay}" />
                                <ToggleButton
                                    HorizontalAlignment="Stretch"
                                    Content="Без звука"
                                    IsChecked="{x:Bind ViewModel.IsMuted, Mode=TwoWay}" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <Button
                    Width="48"
                    Height="48"
                    Command="{x:Bind ViewModel.ToggleFullScreenCommand}"
                    CornerRadius="24"
                    Style="{StaticResource GlassIconButtonStyle}"
                    ToolTipService.ToolTip="Во весь экран">
                    <controls:SvgIcon
                        Width="20"
                        Height="20"
                        Foreground="White"
                        Glyph="{x:Bind FullScreenGlyph, Mode=OneWay}" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
